NODE_ENV=development
PORT=5001

# Local database (npm run db:local) or a MongoDB Atlas address
MONGODB_URI=mongodb://127.0.0.1:27017/project_backend

# Websites allowed to call the API from a browser (website and admin panel), comma separated
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Public address of this API, used in uploaded image links
PUBLIC_API_URL=http://localhost:5001
# The website, for links
FRONTEND_URL=http://localhost:3000

# lax when the frontends share the API's site; none (HTTPS only) when they are on a different site
COOKIE_SAMESITE=lax
# Number of proxies in front of the API, for example 1
TRUST_PROXY=

# Password reset codes by email. Without these, codes are printed in the terminal in development.
SMTP_URL=
MAIL_FROM=

# Optional: called after every website content change
WEBSITE_REVALIDATE_URL=
REVALIDATE_SECRET=
